# Copy this file to .env.local and fill in your values.
# Never commit .env.local to GitHub.

# 1. Make a free account at https://resend.com and create an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# 2. The email address where you want to RECEIVE messages from the contact form
#    (with Resend's free test sender this must be the same email you signed up with)
CONTACT_TO_EMAIL=your-email@example.com
